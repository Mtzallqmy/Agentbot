# Runtime
APP_ENV=development
APP_NAME=AI Agent Platform
APP_SECRET_KEY=CHANGE_ME_WITH_OPENSSL_RAND_HEX_32
ENCRYPTION_MASTER_KEY=CHANGE_ME_WITH_FERNET_KEY
JWT_SECRET=
OWNER_EMAIL=
OWNER_PASSWORD_HASH=
AUTH_COOKIE_SECURE=false
AUTH_SESSION_MINUTES=30
LOG_LEVEL=INFO
PUBLIC_WEB_URL=http://localhost:8080
API_BASE_URL=http://localhost:8080/api
INTERNAL_API_URL=http://api:8000
HTTP_PORT=8080
CORS_ORIGINS=["http://localhost:8080","http://localhost:3000"]

# PostgreSQL and Redis (replace every production value)
POSTGRES_DB=ai_platform
POSTGRES_USER=ai_platform
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_URL=postgresql+asyncpg://ai_platform:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/ai_platform
REDIS_URL=redis://redis:6379/0

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_WITH_OPENSSL_RAND_HEX_32
TELEGRAM_WEBHOOK_PATH=api/v1/telegram/webhook
ADMIN_TELEGRAM_IDS=

# S3-compatible object storage
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=ai-platform
S3_ACCESS_KEY=CHANGE_ME_STORAGE_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_STORAGE_SECRET_KEY
S3_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# GitHub OAuth / GitHub App (optional until integration is enabled)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Limits and retention
MAX_UPLOAD_SIZE=52428800
FILE_RETENTION_HOURS=24
AGENT_MAX_STEPS=40
AGENT_MAX_RUNTIME=1800
MEDIA_MAX_DURATION=7200
MEDIA_MAX_FILE_SIZE=1073741824
MEDIA_OUTPUT_ROOT=/data/media
WORKER_CONCURRENCY=4
WORKER_JOB_TIMEOUT=1800

# Observability (optional)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
PROMETHEUS_ENABLED=true

# Web build/runtime
NEXT_PUBLIC_API_BASE_URL=
NODE_ENV=development
